# =============================================================================
# Buildersuite GLM - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control!
# =============================================================================

# =============================================================================
# Porkbun API Credentials (for domain management)
# =============================================================================
# Get your credentials from: https://porkbun.com/account/api
PORKBUN_API_KEY=YOUR_PORKBUN_API_KEY
PORKBUN_API_SECRET=YOUR_PORKBUN_SECRET_KEY

# =============================================================================
# Browserless API Key (for web scraping/screenshots)
# =============================================================================
# Get your key from: https://browserless.io/
BROWSERLESS_API_KEY=YOUR_BROWSERLESS_API_KEY

# =============================================================================
# Stripe API Credentials
# =============================================================================
# Get from: https://dashboard.stripe.com/test/apikeys
# Use test keys for development, live keys for production
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY

# =============================================================================
# Google Ads API Credentials (optional)
# =============================================================================
# Get from: https://developers.google.com/google-ads/api/docs/first-call/overview
GOOGLE_ADS_DEVELOPER_TOKEN=YOUR_GOOGLE_ADS_DEVELOPER_TOKEN

# =============================================================================
# Supabase Configuration (per-template)
# =============================================================================
# Each template has its own Supabase project configuration
# See individual template .env.example files for details
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Notion Integration (optional)
# =============================================================================
# For syncing project documentation to Notion
# NOTION_TOKEN=secret_xxx
# NOTION_DATABASE_ID=xxx

# =============================================================================
# Server Configuration
# =============================================================================
# Server IP or domain for deployments
SERVER_IP=YOUR_SERVER_IP
SERVER_DOMAIN=your-domain.com
