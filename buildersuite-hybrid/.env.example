# =============================================================================
# BuilderSuite Hybrid - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control!
# =============================================================================

# =============================================================================
# Porkbun API Credentials (Required for domain management)
# =============================================================================
# Get your credentials from: https://porkbun.com/account/api
# 1. Create an API key (or use an existing one)
# 2. Copy the API Key and Secret Key
# 3. Paste them below

PORKBUN_API_KEY=YOUR_PORKBUN_API_KEY
PORKBUN_API_SECRET=YOUR_PORKBUN_SECRET_KEY

# =============================================================================
# Browserless API Key (Required for web scraping)
# =============================================================================
# Get from: https://www.browserless.io/

BROWSERLESS_API_KEY=YOUR_BROWSERLESS_API_KEY

# =============================================================================
# Stripe API Credentials (Required for payments)
# =============================================================================
# Get from: https://dashboard.stripe.com/test/apikeys
# Use test mode keys (sk_test_*) for development

STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY

# =============================================================================
# Google Ads API (Required for keyword research)
# =============================================================================
# Get from: https://ads.google.com/aw/apicenter

GOOGLE_ADS_DEVELOPER_TOKEN=YOUR_GOOGLE_ADS_DEVELOPER_TOKEN

# =============================================================================
# Supabase Configuration (Required for database)
# =============================================================================
# Get from: https://supabase.com/dashboard
# Example: https://your-project.supabase.co

SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# =============================================================================
# OpenAI API (Required for AI features)
# =============================================================================
# Get from: https://platform.openai.com/api-keys

OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# =============================================================================
# Runware API (Required for image generation)
# =============================================================================
# Get from: https://runware.ai/

RUNWARE_API_KEY=YOUR_RUNWARE_API_KEY

# =============================================================================
# GitHub Configuration (Required for repository operations)
# =============================================================================
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo, workflow, read:org

GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# =============================================================================
# Deployment Configuration
# =============================================================================
# Your domain for deployments (e.g., your-domain.com)
DEPLOYMENT_DOMAIN=your-domain.com

# Server IP for SSH deployments
SERVER_IP=YOUR_SERVER_IP

# SSH Key path for deployments
SSH_KEY_PATH=~/.ssh/id_rsa

# =============================================================================
# Email Configuration (Optional - for notifications)
# =============================================================================
# SMTP settings for sending notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
NOTIFICATION_EMAIL=your-email@example.com
