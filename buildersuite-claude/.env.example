# =============================================================================
# BuilderSuite - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git (it's already in .gitignore)
# =============================================================================

# =============================================================================
# Porkbun Domain API Credentials (Optional - for automated domain management)
# =============================================================================
# Get your API credentials from: https://porkbun.com/account/api
PORKBUN_API_KEY=YOUR_PORKBUN_API_KEY
PORKBUN_API_SECRET=YOUR_PORKBUN_SECRET_KEY

# =============================================================================
# Browserless API Key (Optional - for web scraping capabilities)
# =============================================================================
# Get your API key from: https://browserless.io/
BROWSERLESS_API_KEY=YOUR_BROWSERLESS_API_KEY

# =============================================================================
# Stripe API Credentials (Required for billing functionality)
# =============================================================================
# Get your API keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY

# =============================================================================
# Google Ads API Credentials (Optional - for advertising integration)
# =============================================================================
# Get your developer token from: https://ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN=YOUR_GOOGLE_ADS_DEVELOPER_TOKEN

# =============================================================================
# Supabase Configuration (Required for database/auth)
# =============================================================================
# These are set per-project by the supabase-deployer agent
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# =============================================================================
# Notion Integration (Optional - for project management)
# =============================================================================
NOTION_TOKEN=YOUR_NOTION_TOKEN
NOTION_PROJECTS_DB_ID=YOUR_NOTION_PROJECTS_DB_ID
NOTION_NOTES_DB_ID=YOUR_NOTION_NOTES_DB_ID

# =============================================================================
# Application Configuration
# =============================================================================
# Your primary domain for deployed applications
DOMAIN=your-domain.com

# Environment (development|staging|production)
NODE_ENV=development

# Port for local development
PORT=3000
